:root {
  font-family: Inter, system-ui, sans-serif;
  color: #2b2118;
  background:
    radial-gradient(circle at top left, rgba(207, 178, 107, 0.22), transparent 28%),
    radial-gradient(circle at bottom left, rgba(191, 160, 92, 0.2), transparent 24%),
    linear-gradient(135deg, #f9f5ee 0%, #f7f0e2 40%, #fcfaf6 100%);
  color-scheme: light;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.page-shell {
  min-height: 100vh;
  color: #2b2118;
}

.page-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 16px 48px;
}

.card {
  border: 1px solid #eadfca;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18px 60px rgba(170, 140, 80, 0.08);
  backdrop-filter: blur(6px);
}

.hero-card,
.price-card,
.form-card,
.agenda-card,
.admin-card {
  border-radius: 32px;
}

.hero-card {
  overflow: hidden;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 20px 80px rgba(170, 140, 80, 0.12);
}

.hero-grid {
  display: grid;
  gap: 24px;
  padding: 24px;
}

.eyebrow-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #e8dcc7;
  background: #fbf7ef;
  color: #9d7d43;
  padding: 10px 16px;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 600;
}

.eyebrow-text,
.section-kicker,
.availability-label {
  text-transform: uppercase;
  letter-spacing: 0.3em;
  color: #b89b5e;
  font-size: 12px;
}

.hero-title,
.section-title,
.admin-list-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
}

.hero-title {
  font-size: clamp(44px, 8vw, 74px);
  margin: 12px 0 0;
  line-height: 0.95;
}

.hero-copy {
  max-width: 670px;
  color: #5a5048;
  line-height: 1.8;
  margin-top: 16px;
}

.side-card {
  border: 1px solid #efe4d2;
  background: #fffaf2;
  border-radius: 28px;
  padding: 24px;
}

.availability-card {
  background: white;
  border-radius: 20px;
  padding: 16px;
  box-shadow: 0 8px 30px rgba(170, 140, 80, 0.08);
}

.availability-list {
  display: grid;
  gap: 14px;
  margin-top: 12px;
}

.availability-item,
.agenda-time,
.agenda-detail,
.confirmation-title,
.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.availability-item {
  color: #5a5048;
}

.availability-item svg,
.agenda-detail svg,
.agenda-time svg,
.confirmation-title svg,
.secondary-button svg,
.primary-button svg {
  color: #b89b5e;
}

.availability-day {
  font-weight: 600;
  color: #2b2118;
}

.price-card,
.form-card,
.agenda-card,
.admin-card {
  padding: 24px;
}

.price-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}

.section-title {
  font-size: 42px;
  color: #8f7645;
  margin: 6px 0 0;
}

.section-title.dark,
.admin-list-title {
  color: #2b2118;
}

.mail-chip {
  border: 1px solid #eadfca;
  background: #fbf7ef;
  padding: 12px 16px;
  border-radius: 999px;
  color: #61584f;
  font-size: 14px;
}

.price-grid,
.booking-grid,
.field-row,
.admin-panel-grid {
  display: grid;
  gap: 24px;
}

.price-panel,
.confirmation-card,
.agenda-date-box,
.admin-panel,
.empty-box {
  border-radius: 24px;
  border: 1px solid #efe4d2;
  background: #fffaf2;
}

.price-panel {
  padding: 20px;
}

.price-panel-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 30px;
  color: #b89b5e;
  margin-bottom: 14px;
}

.price-list {
  display: grid;
  gap: 10px;
}

.price-row {
  display: flex;
  justify-content: space-between;
  gap: 20px;
}

.booking-form {
  display: grid;
  gap: 20px;
}

.field-group {
  display: grid;
  gap: 8px;
}

.field-group label {
  color: #8f7645;
  font-weight: 600;
}

.field-group input,
.field-group select,
.field-group textarea {
  width: 100%;
  border-radius: 18px;
  border: 1px solid #e8dcc7;
  background: #fffdf9;
  color: #2b2118;
  padding: 14px 16px;
  outline: none;
}

.field-group textarea {
  min-height: 110px;
  resize: vertical;
}

.times-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.time-pill {
  border-radius: 999px;
  border: 1px solid #e8dcc7;
  background: white;
  padding: 10px 16px;
  transition: 0.2s ease;
}

.time-pill:hover {
  border-color: #c8ae76;
}

.time-pill.active {
  background: #b89b5e;
  border-color: #b89b5e;
  color: white;
}

.primary-button,
.secondary-button {
  justify-content: center;
  border-radius: 999px;
  padding: 12px 20px;
  border: none;
  font-weight: 600;
}

.primary-button {
  background: #b89b5e;
  color: white;
}

.primary-button:hover {
  background: #a8894e;
}

.secondary-button {
  background: white;
  border: 1px solid #d8c29a;
  color: #2b2118;
}

.secondary-button.ghost {
  background: rgba(255, 255, 255, 0.8);
}

.form-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: flex-start;
}

.status-text,
.help-text,
.confirmation-card p,
.empty-box {
  color: #665d56;
}

.confirmation-card {
  display: grid;
  gap: 14px;
  padding: 20px;
  margin-top: 20px;
}

.confirmation-title {
  color: #2b2118;
  font-weight: 600;
}

.agenda-date-box,
.empty-box,
.admin-panel {
  padding: 16px;
}

.badge {
  background: #f4ead7;
  color: #8f7645;
  border-radius: 999px;
  padding: 6px 12px;
  font-size: 13px;
}

.agenda-list,
.admin-list-wrap {
  display: grid;
  gap: 12px;
}

.agenda-item,
.admin-item {
  border-radius: 24px;
  border: 1px solid #efe4d2;
  background: #fffdf9;
  padding: 16px;
}

.agenda-item-top,
.admin-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
}

.agenda-detail {
  color: #5a5048;
  margin-top: 8px;
}

.admin-toggle-wrap {
  margin-top: 32px;
}

.admin-login {
  display: grid;
  gap: 12px;
  max-width: 360px;
}

.field-group.narrow {
  max-width: 360px;
}

.admin-panel.wide {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  display: grid;
  gap: 16px;
}

.admin-item-title {
  font-weight: 700;
  color: #2b2118;
  margin-bottom: 4px;
}

@media (min-width: 900px) {
  .hero-grid {
    grid-template-columns: 1.3fr 0.7fr;
    padding: 40px;
  }

  .price-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .booking-grid {
    grid-template-columns: 1.08fr 0.92fr;
  }

  .field-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .admin-panel-grid {
    grid-template-columns: 0.9fr 1.1fr;
  }
}

@media (max-width: 899px) {
  .admin-panel.wide,
  .admin-item,
  .agenda-item-top,
  .price-header {
    grid-template-columns: 1fr;
    display: grid;
  }

  .mail-chip {
    width: fit-content;
  }
}
